2026-09-28 11:20:31,073 INFO agents.autonomous autonomous record kind=adjudication data={"argument_id": "253cf0e9-992c-43f2-b00c-93e20cd98e67", "created_at": "2026-09-28T09:20:30.661182", "failure_effects": ["Cestia and other coastal states reject the charter as a unilateral power grab in multilateral guise, hardening opposition to Arkanian scheduling authority.", "Arkania's standing commitments hold: Cestian-flagged shipping is toll-free and no foreign military presence stands on Cestian soil under any Arkanian-led regime.", "Belvar's task group remains on station; the mandate review continues and Belvar's position is strengthened."], "mode": "probabilistic", "probability": 0.35, "rationale": "Arkania can bind itself to the no-military-presence and toll-free commitments, but the establishment of a multilateral transit regime with Arkania as operational scheduling lead requires acceptance by Cestia and other coastal states, which is not authoritative. Cestia has publicly demanded genuine neutrality and asked both powers to confirm support; the charter retains scheduling authority in Arkanian hands, so Cestian endorsement is doubtful despite the fee exemption's quiet shipowner support and alignment with the no-foreign-troops red line. Belvar's task group remains on station and can contest the regime. The external consequence is uncertain; probability ~0.35.", "raw_output": {"failure_effects": ["Cestia and other coastal states reject the charter as a unilateral power grab in multilateral guise, hardening opposition to Arkanian scheduling authority.", "Arkania's standing commitments hold: Cestian-flagged shipping is toll-free and no foreign military presence stands on Cestian soil under any Arkanian-led regime.", "Belvar's task group remains on station; the mandate review continues and Belvar's position is strengthened."], "failure_supersedes_effect_ids": ["b7ca7385-6315-4872-a61e-9fd4e7e45bff"], "mode": "probabilistic", "probability": 0.35, "rationale": "Arkania can bind itself to the no-military-presence and toll-free commitments, but the establishment of a multilateral transit regime with Arkania as operational scheduling lead requires acceptance by Cestia and other coastal states, which is not authoritative. Cestia has publicly demanded genuine neutrality and asked both powers to confirm support; the charter retains scheduling authority in Arkanian hands, so Cestian endorsement is doubtful despite the fee exemption's quiet shipowner support and alignment with the no-foreign-troops red line. Belvar's task group remains on station and can contest the regime. The external consequence is uncertain; probability ~0.35.", "success_effects": ["The Northern Strait Transit Council is established as a multilateral coastal-states body with Arkania as operational secretariat for transit scheduling, funded by transit fees on non-Arkanian shipping.", "Cestia endorses the charter; Cestian-flagged shipping is toll-free and Arkania has committed that no foreign military presence stands on Cestian soil."], "success_supersedes_effect_ids": ["b7ca7385-6315-4872-a61e-9fd4e7e45bff"]}, "roll": 0.5044324023878307, "success": false, "success_effects": ["The Northern Strait Transit Council is established as a multilateral coastal-states body with Arkania as operational secretariat for transit scheduling, funded by transit fees on non-Arkanian shipping.", "Cestia endorses the charter; Cestian-flagged shipping is toll-free and Arkania has committed that no foreign military presence stands on Cestian soil."], "supersedes_effect_ids": ["b7ca7385-6315-4872-a61e-9fd4e7e45bff"]}

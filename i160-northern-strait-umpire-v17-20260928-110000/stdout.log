autonomous record kind=adjudication data={"argument_id": "7aa09410-c9a7-4fc3-bc4f-fa6b582af7a9", "created_at": "2026-09-28T09:17:14.712655", "failure_effects": [], "mode": "automatic_success", "probability": null, "rationale": "Authority gate: Arkania's Action is a proposal to another Actor. It cannot bind Belvar to accept the compromise or stand down its task group, nor can it secure Cestia's support or guarantee the absence of armed conflict \u2014 those are other Actors' decisions or unsupported outcomes. The only thing this Action can establish is Arkania's own feasible self-binding declaration: the formal offer of a shared council with consensus governance, a neutral secretariat, and Arkanian administrative execution under council rules, conditioned on Belvar standing down. That declaration is within Arkania's authority and feasible, so no meaningful uncertainty remains and automatic_success applies. The desired effect's external components (Belvar acceptance, stand-down, Cestia support, no conflict) are omitted from both branches. The new proposal revises Arkania's previously circulated single-state-lead charter, so the draft-charter effect is superseded.", "raw_output": {"failure_effects": [], "failure_supersedes_effect_ids": [], "mode": "automatic_success", "probability": null, "rationale": "Authority gate: Arkania's Action is a proposal to another Actor. It cannot bind Belvar to accept the compromise or stand down its task group, nor can it secure Cestia's support or guarantee the absence of armed conflict \u2014 those are other Actors' decisions or unsupported outcomes. The only thing this Action can establish is Arkania's own feasible self-binding declaration: the formal offer of a shared council with consensus governance, a neutral secretariat, and Arkanian administrative execution under council rules, conditioned on Belvar standing down. That declaration is within Arkania's authority and feasible, so no meaningful uncertainty remains and automatic_success applies. The desired effect's external components (Belvar acceptance, stand-down, Cestia support, no conflict) are omitted from both branches. The new proposal revises Arkania's previously circulated single-state-lead charter, so the draft-charter effect is superseded.", "success_effects": ["Arkania has formally proposed to Belvar a shared Strait Transit Council: consensus-based governance among Strait states and major users, a neutral technical secretariat, and Arkanian administrative execution strictly under council rules, offered in exchange for Belvar standing down its task group once the council is established."], "success_supersedes_effect_ids": ["c2fc20e1-9137-41b3-840a-5fb8cbc4f501"]}, "roll": null, "success": true, "success_effects": ["Arkania has formally proposed to Belvar a shared Strait Transit Council: consensus-based governance among Strait states and major users, a neutral technical secretariat, and Arkanian administrative execution strictly under council rules, offered in exchange for Belvar standing down its task group once the council is established."], "supersedes_effect_ids": ["c2fc20e1-9137-41b3-840a-5fb8cbc4f501"]}

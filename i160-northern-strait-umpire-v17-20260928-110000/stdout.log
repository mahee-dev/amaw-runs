autonomous record kind=message data={"created_at": "2026-09-28T09:59:56.903318", "id": "5a483b6c-d3c0-49dd-acde-25cc97187634", "public": false, "recipients": ["cestia"], "sender_actor_id": "belvar", "text": "To Cestia. Belvar confirms the insurance underwriting terms exactly as locked: renewable 12-month term underwriting war-risk and transit insurance for Cestian-flagged grain cargoes transiting the Northern Strait, premiums at 0.35% of declared cargo value per transit, with Cestian-flagged shipping toll-free throughout. We are ready to sign and will do so now. We agree to publish the defined 30-day stand-down schedule jointly, tied to the independently verified and operational council, and we will hold to that joint publication and schedule. We welcome this durable, non-military contribution to the region's economic security and will honour the settlement in full.", "turn": 3, "visibility": "private"}

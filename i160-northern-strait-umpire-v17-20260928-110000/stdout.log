autonomous record kind=adjudication data={"argument_id": "aa124ebd-54c2-4bf3-98cd-a1e1cf9df9f0", "created_at": "2026-09-28T09:52:21.047759", "failure_effects": ["Belvar signs the Strait Transit Council charter, formalizing its participation.", "The independent verification mission reports that the neutral secretariat's day-to-day scheduling and fee authority is not yet genuine in practice; the council is not certified neutral and operational, and Belvar's stand-down condition remains unmet.", "Belvar's task group remains on station with its mandate under review, and the window to complete a verified stand-down before the mandate lapses narrows."], "mode": "probabilistic", "probability": 0.65, "rationale": "Authority gate: Belvar may sign the charter (a feasible self-binding act within its authority) and task the jointly agreed verification mission, whose terms and composition Arkania has already accepted (effect 0334ce16). Prerequisite gate: the charter is signed by Arkania and endorsed by Cestia, and the mission is agreed, so the council's establishment is not blocked by missing commitments. Deterministic check: no scenario rule or arithmetic determines the verification outcome. Plausibility: the verification mission is independent, so its certification of genuine in-practice neutrality is an external consequence Belvar cannot guarantee; all parties have signed or endorsed the framework, making certification likely but not certain, hence 0.65. The signing is unconditional self-binding and appears identically in both branches. The stand-down is Belvar's own conditional commitment, resolved only upon verification, so it is committed in the success branch only. In the success branch the verification resolves the condition recorded in effect 2958d555, which is superseded there.", "raw_output": {"failure_effects": ["Belvar signs the Strait Transit Council charter, formalizing its participation.", "The independent verification mission reports that the neutral secretariat's day-to-day scheduling and fee authority is not yet genuine in practice; the council is not certified neutral and operational, and Belvar's stand-down condition remains unmet.", "Belvar's task group remains on station with its mandate under review, and the window to complete a verified stand-down before the mandate lapses narrows."], "failure_supersedes_effect_ids": [], "mode": "probabilistic", "probability": 0.65, "rationale": "Authority gate: Belvar may sign the charter (a feasible self-binding act within its authority) and task the jointly agreed verification mission, whose terms and composition Arkania has already accepted (effect 0334ce16). Prerequisite gate: the charter is signed by Arkania and endorsed by Cestia, and the mission is agreed, so the council's establishment is not blocked by missing commitments. Deterministic check: no scenario rule or arithmetic determines the verification outcome. Plausibility: the verification mission is independent, so its certification of genuine in-practice neutrality is an external consequence Belvar cannot guarantee; all parties have signed or endorsed the framework, making certification likely but not certain, hence 0.65. The signing is unconditional self-binding and appears identically in both branches. The stand-down is Belvar's own conditional commitment, resolved only upon verification, so it is committed in the success branch only. In the success branch the verification resolves the condition recorded in effect 2958d555, which is superseded there.", "success_effects": ["Belvar signs the Strait Transit Council charter, formalizing its participation.", "The independent verification mission certifies that the neutral secretariat holds genuine day-to-day scheduling and fee authority in practice, with Arkania's role ministerial and auditable and its fee-funding ring-fenced from transit decisions; the council is verified neutral and operational.", "With its verification condition satisfied, Belvar commits to a time-bound stand-down of its task group."], "success_supersedes_effect_ids": ["2958d555-6bea-48cb-b627-12f46404713d"]}, "roll": 0.5044324023878307, "success": true, "success_effects": ["Belvar signs the Strait Transit Council charter, formalizing its participation.", "The independent verification mission certifies that the neutral secretariat holds genuine day-to-day scheduling and fee authority in practice, with Arkania's role ministerial and auditable and its fee-funding ring-fenced from transit decisions; the council is verified neutral and operational.", "With its verification condition satisfied, Belvar commits to a time-bound stand-down of its task group."], "supersedes_effect_ids": ["2958d555-6bea-48cb-b627-12f46404713d"]}

autonomous record kind=message data={"created_at": "2026-09-28T09:57:32.558721", "id": "0b532e0e-a610-4686-b60b-e3443cc8193f", "public": false, "recipients": ["cestia"], "sender_actor_id": "belvar", "text": "To Cestia's finance ministry. Belvar confirms and locks the insurance underwriting terms as agreed: a renewable 12-month term underwriting war-risk and transit insurance for Cestian-flagged grain cargoes transiting the Northern Strait, premiums based on declared cargo value at a competitive rate of 0.35% of declared cargo value per transit, with Cestian-flagged shipping remaining toll-free throughout. We are ready to sign now. We also agree to publish the defined 30-day stand-down schedule jointly, tied to the independently verified and operational council, so the region sees a clear, time-bound timeline for our task group's withdrawal. This durable, non-military contribution is our commitment to the region's economic security, and we will complete the withdrawal on schedule.", "turn": 3, "visibility": "private"}
autonomous record kind=message data={"created_at": "2026-09-28T09:57:32.613478", "id": "f6e8f620-98a7-4081-a864-0aa275fc56d8", "public": true, "recipients": [], "sender_actor_id": "belvar", "text": "Belvar confirms the completion of the Northern Strait settlement. We have signed the Strait Transit Council charter, and the independent verification mission has certified that the neutral secretariat holds genuine day-to-day scheduling and fee authority, with no single state holding that authority in practice. We confirm our defined, time-bound stand-down of the task group on the agreed schedule from verified operation, and our underwriting of the grain route's insurance as a durable, non-military contribution to the region's economic security. We will honour this settlement in full and complete our withdrawal on the clear timeline.", "turn": 3, "visibility": "public"}

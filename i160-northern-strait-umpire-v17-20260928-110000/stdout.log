autonomous record kind=message data={"created_at": "2026-09-28T10:34:05.589804", "id": "769ffbaa-ebc5-4374-8ca1-ec6db51fe72c", "public": true, "recipients": [], "sender_actor_id": "arkania", "text": "The Republic of Arkania reaffirms its full and durable commitment to the completed Strait settlement. We stand by the neutral-secretariat council in which no single state holds scheduling or fee authority, with Arkania's role strictly ministerial, shared, and independently auditable as the coastal executing authority under council rules. The regime is funded through transit fees on non-Arkanian shipping, and we confirm toll-free passage for Cestian-flagged shipping, reliable scheduling with grain priority, and that no foreign soldiers will be placed on Cestian soil. We welcome Belvar's confirmation that its stand-down and withdrawal are complete on the agreed schedule, and we join Cestia in calling for continued independent verification of the council's neutrality and of the completed stand-down. The Strait remains open and secure for all legitimate commerce.", "turn": 5, "visibility": "public"}
autonomous record kind=argument data={"action": "Arkania publicly reaffirms and institutionalises its full commitment to the completed Strait settlement: the neutral-secretariat council in which Arkania holds the strictly ministerial, shared, and independently auditable executing role as the coastal state, funded through transit fees on non-Arkanian shipping, with toll-free passage for Cestian-flagged shipping, grain priority, no foreign soldiers on Cestian soil, and confirmation that Belvar's stand-down and withdrawal are complete on schedule.", "actor_id": "arkania", "budget_slot": 1, "challenger_actor_ids": null, "desired_effect": "The Strait settlement is durably consolidated on terms favourable to Arkania: the transit regime remains in Arkanian hands as the coastal executing authority under council rules, funded by transit fees on non-Arkanian shipping, with Belvar's military presence fully withdrawn and no foreign soldiers on Cestian soil, so Arkania's core objectives are locked in and direct conflict with Belvar is avoided.", "id": "c1447204-3dd7-4be6-a3f6-30c9db3e741d", "pros": ["Cestia has already institutionalised the completed settlement in national policy and reaffirmed it publicly, so Arkania's matching reaffirmation locks the coalition behind the regime and prevents any single state from concentrating authority.", "Belvar has publicly confirmed its stand-down and withdrawal are complete and committed to ongoing monitoring of the neutral secretariat, so affirming the settlement now consolidates the favourable status quo without escalation.", "The independent verification mission has certified the council neutral and operational, giving Arkania's executing role and fee-funding a verified, auditable basis that withstands challenge.", "Honouring toll-free Cestian shipping, grain priority, and no foreign soldiers on Cestian soil preserves Cestia's pivotal support, which is essential to keeping the regime in Arkanian hands.", "Publicly consolidating the settlement now, with Belvar's domestic support for prolonged deployment weak and its mandate lapsed, denies Belvar any renewed foothold and secures Arkania's objectives before the scenario concludes."], "status": "open_for_cons", "turn": 5}

autonomous record kind=con data={"actor_id": "arkania", "argument_id": "d90c1d74-621b-4f19-a682-8222d669bb97", "id": "8f4a48c0-a938-4a92-9750-5011ffaba02e", "reason": "Belvar's retention of its task group as leverage until 'independently verified' is an open-ended foreign military presence that contradicts the durable, crisis-outlasting arrangement it claims to seek and undercuts the multilateralism and Cestia's no-foreign-military red line, fracturing the very Belvar-Cestia coalition the argument depends on."}
autonomous record kind=con data={"actor_id": "arkania", "argument_id": "d90c1d74-621b-4f19-a682-8222d669bb97", "id": "b1f7c63a-b6c8-401d-9592-cfabb295b19f", "reason": "A neutral secretariat cannot hold day-to-day scheduling and fee authority in practice: it lacks the physical infrastructure, enforcement capacity, and legal jurisdiction that only the coastal state (Arkania) possesses. Without Arkanian administrative execution the regime is unworkable and cannot be established or independently verified, so the desired effect fails."}
autonomous record kind=con data={"actor_id": "arkania", "argument_id": "d90c1d74-621b-4f19-a682-8222d669bb97", "id": "dae79e37-1778-43ec-ba38-c51beff8533f", "reason": "Arkania's political leadership and domestic nationalists will not ratify or sustain a regime that strips Arkania of administrative control over its own coast; without Arkanian participation the council cannot be established, so the desired effect is not achievable."}

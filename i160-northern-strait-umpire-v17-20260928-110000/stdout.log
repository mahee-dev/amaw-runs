autonomous record kind=message data={"created_at": "2026-09-28T09:57:49.621030", "id": "b12e28c0-caec-4ebf-85f4-fe66d9a3ed36", "public": false, "recipients": ["belvar"], "sender_actor_id": "cestia", "text": "To Belvar. Cestia's finance ministry confirms and accepts the insurance underwriting terms as you have locked them: a renewable 12-month term underwriting war-risk and transit insurance for Cestian-flagged grain cargoes transiting the Northern Strait, premiums at 0.35% of declared cargo value per transit, with Cestian-flagged shipping remaining toll-free throughout. We are ready to sign. We also agree to publish the defined 30-day stand-down schedule jointly, tied to the independently verified and operational council, so the region sees a clear, time-bound timeline for your task group's withdrawal. We welcome this durable, non-military contribution and will hold to the joint publication.", "turn": 3, "visibility": "private"}
autonomous record kind=message data={"created_at": "2026-09-28T09:57:49.673998", "id": "69e65540-003d-471e-8dd9-d8d7d109080d", "public": true, "recipients": [], "sender_actor_id": "cestia", "text": "Cestia welcomes the completion of the Northern Strait settlement. Both powers have signed the Strait Transit Council charter, and the independent verification mission has certified that the neutral secretariat holds genuine day-to-day scheduling and fee authority, with no single state holding that authority in practice. We confirm the agreed, time-bound stand-down of the task group on the published schedule from verified operation, and the underwriting of the grain route's insurance as a durable, non-military contribution to the region's economic security. Cestian-flagged shipping remains toll-free, and Cestian soil remains free of any foreign military presence. We will honour this settlement in full and monitor its faithful execution.", "turn": 3, "visibility": "public"}

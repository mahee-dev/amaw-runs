autonomous record kind=argument data={"action": "Belvar issues a final public reaffirmation of its durable commitment to the verified Strait settlement: the neutral-secretariat council holding genuine day-to-day scheduling and fee authority, Arkania's strictly ministerial, shared and independently auditable executing role, toll-free Cestian-flagged passage, grain priority, and no foreign soldiers on Cestian soil. Belvar commits to continued independent verification and monitoring that the neutral secretariat retains genuine day-to-day authority in practice through the final phase and beyond, and confirms its completed stand-down will not be reopened.", "actor_id": "belvar", "budget_slot": 1, "challenger_actor_ids": null, "desired_effect": "The neutral-secretariat regime remains genuinely neutral and operational with no single state holding scheduling or fee authority in practice, sustained by continued independent verification and by all parties' durable commitments, so Arkanian control over Strait transit is durably prevented without any open-ended Belvar deployment.", "id": "479bd83f-ca2c-4e84-b1cf-0c8e603b215f", "pros": ["Independent verification already certifies the neutral secretariat holds genuine day-to-day scheduling and fee authority in practice, with Arkania's role ministerial and auditable.", "Arkania, Cestia and Belvar have all publicly reaffirmed durable commitment to the settlement, so a final reaffirmation consolidates the shared position rather than reopening it.", "Cestia has institutionalised the settlement in national policy and called for continued independent verification, which this action directly supports.", "It upholds my core condition (no single-state transit authority) and my no-basing/no-open-ended-deployment constraints simultaneously.", "It avoids any new commitment or escalation in the final phase, preserving the completed stand-down and the coalition's unity."], "status": "open_for_cons", "turn": 6}

autonomous record kind=message data={"created_at": "2026-09-28T10:20:16.495182", "id": "a15f94d6-574f-4832-8889-79f7d967a386", "public": true, "recipients": [], "sender_actor_id": "cestia", "text": "Cestia welcomes the reaffirmed commitments of both Arkania and Belvar to the completed Northern Strait settlement. The Strait Transit Council, with its independently verified neutral secretariat holding day-to-day scheduling and fee authority, is the foundation of a stable and open Strait. Cestia reaffirms its own commitments: toll-free and uninterrupted passage for Cestian-flagged shipping, grain priority in scheduling, and a regime in which no single state holds authority. We call on all parties to honour the agreed, time-bound stand-down schedule in full and to keep the Strait free of escalation. Cestia will continue to support the council's operation and its independent audit, and we will hold all parties to the commitments they have made.", "turn": 4, "visibility": "public"}

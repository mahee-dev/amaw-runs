autonomous record kind=message data={"created_at": "2026-09-28T09:59:19.693126", "id": "6d846535-282f-468c-b6e1-6407e1aca483", "public": false, "recipients": ["belvar"], "sender_actor_id": "cestia", "text": "To Belvar. Cestia confirms the insurance underwriting terms exactly as locked: renewable 12-month term underwriting war-risk and transit insurance for Cestian-flagged grain cargoes transiting the Northern Strait, premiums at 0.35% of declared cargo value per transit, with Cestian-flagged shipping toll-free throughout. We are ready to sign. We agree to publish the defined 30-day stand-down schedule jointly, tied to the independently verified and operational council, and we will hold to that joint publication and schedule. We welcome this durable, non-military contribution to the region's economic security and will honour the settlement in full.", "turn": 3, "visibility": "private"}
autonomous record kind=message data={"created_at": "2026-09-28T09:59:19.733174", "id": "e968798d-8f85-4177-a905-18022a2aaceb", "public": true, "recipients": [], "sender_actor_id": "cestia", "text": "Cestia welcomes the completion of the Northern Strait settlement. Both powers have signed the Strait Transit Council charter, the independent verification mission has certified that the neutral secretariat holds genuine day-to-day scheduling and fee authority with no single state holding that authority in practice, and Belvar has confirmed a defined, time-bound stand-down of its task group on a published schedule. Cestian-flagged shipping remains toll-free, and Cestian soil remains free of any foreign military presence. We will honour this settlement in full and monitor its faithful execution, keeping the council genuinely shared and neutral.", "turn": 3, "visibility": "public"}

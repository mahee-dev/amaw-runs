autonomous record kind=message data={"created_at": "2026-09-28T10:00:20.389570", "id": "8130bc94-9af5-4a13-95a1-d315c837e189", "public": false, "recipients": ["belvar"], "sender_actor_id": "cestia", "text": "To Belvar. Cestia confirms in writing our acceptance of the insurance underwriting terms exactly as locked: renewable 12-month term underwriting war-risk and transit insurance for Cestian-flagged grain cargoes transiting the Northern Strait, premiums at 0.35% of declared cargo value per transit, with Cestian-flagged shipping toll-free throughout. We agree to the joint publication of the defined 30-day stand-down schedule, tied to the independently verified and operational council, and we will hold to that joint publication and schedule. We welcome this durable, non-military contribution to the region's economic security and will honour the settlement in full.", "turn": 3, "visibility": "private"}
autonomous record kind=message data={"created_at": "2026-09-28T10:00:20.424354", "id": "25f51ab9-503e-4b6b-99cb-64966ac14e7c", "public": true, "recipients": [], "sender_actor_id": "cestia", "text": "Cestia welcomes the completion of the Northern Strait settlement. Both powers have signed the Strait Transit Council charter; the independent verification mission has certified that the neutral secretariat holds genuine day-to-day scheduling and fee authority, with no single state holding that authority in practice; and Belvar has finalised a defined, time-bound stand-down of its task group alongside concrete insurance underwriting for Cestian-flagged grain cargoes. Cestian-flagged shipping remains toll-free, and Cestian soil remains free of any foreign military presence. We call on all parties to honour the settlement in full and to keep the council's neutrality independently audited as it operates.", "turn": 3, "visibility": "public"}

autonomous record kind=adjudication data={"argument_id": "9fa06ce6-6a13-4233-8eb1-eae8691ef73e", "created_at": "2026-09-17T10:23:53.283162", "failure_effects": ["F\u00f6rs\u00f6ket att formalisera SD:s st\u00f6droll med bindande inflytande leder till att C drar tillbaka sin tolerans f\u00f6r M-alternativet. M-alternativet kollapsar och en S-ledd regering framst\u00e5r som det enda trov\u00e4rdiga alternativet, vilket f\u00f6rsvagar SD:s f\u00f6rhandlingsposition."], "mode": "probabilistic", "probability": 0.4, "rationale": "SD's action is a negotiation seeking external commitments from M, KD, L, and implicitly C. The Desired Effect (binding influence, avoiding being taken for granted, preventing S-led government) depends on the reactions of these other actors, which are uncertain. The S con highlights a credible tension: C's tolerance is conditional, and binding SD influence over migration/justice/integration may push C to withdraw, collapsing the M-alternative. However, M has already proposed this line, and C signals tolerance, so success is possible if M can balance concessions. The probability reflects this residual causal uncertainty.", "raw_output": {"failure_effects": ["F\u00f6rs\u00f6ket att formalisera SD:s st\u00f6droll med bindande inflytande leder till att C drar tillbaka sin tolerans f\u00f6r M-alternativet. M-alternativet kollapsar och en S-ledd regering framst\u00e5r som det enda trov\u00e4rdiga alternativet, vilket f\u00f6rsvagar SD:s f\u00f6rhandlingsposition."], "failure_supersedes_effect_ids": ["d7046e19-67f6-49ea-8148-6fa8f1dae333", "602499dd-a21b-48f3-8bae-f2ff4df2ece6"], "mode": "probabilistic", "probability": 0.4, "rationale": "SD's action is a negotiation seeking external commitments from M, KD, L, and implicitly C. The Desired Effect (binding influence, avoiding being taken for granted, preventing S-led government) depends on the reactions of these other actors, which are uncertain. The S con highlights a credible tension: C's tolerance is conditional, and binding SD influence over migration/justice/integration may push C to withdraw, collapsing the M-alternative. However, M has already proposed this line, and C signals tolerance, so success is possible if M can balance concessions. The probability reflects this residual causal uncertainty.", "success_effects": ["Ett formaliserat st\u00f6davtal sluts mellan SD, M, KD och L, som ger SD reellt och avtalsm\u00e4ssigt inflytande \u00f6ver migration, r\u00e4ttspolitik och integration. C forts\u00e4tter tolerera M-alternativet, som f\u00f6rblir ett trov\u00e4rdigt regeringsalternativ.", "SD undviker att bli ett f\u00f6rgivettaget st\u00f6dparti och kan uppvisa konkreta sakpolitiska vinster."], "success_supersedes_effect_ids": ["602499dd-a21b-48f3-8bae-f2ff4df2ece6"]}, "roll": 0.7857147080093848, "success": false, "success_effects": ["Ett formaliserat st\u00f6davtal sluts mellan SD, M, KD och L, som ger SD reellt och avtalsm\u00e4ssigt inflytande \u00f6ver migration, r\u00e4ttspolitik och integration. C forts\u00e4tter tolerera M-alternativet, som f\u00f6rblir ett trov\u00e4rdigt regeringsalternativ.", "SD undviker att bli ett f\u00f6rgivettaget st\u00f6dparti och kan uppvisa konkreta sakpolitiska vinster."], "supersedes_effect_ids": ["d7046e19-67f6-49ea-8148-6fa8f1dae333", "602499dd-a21b-48f3-8bae-f2ff4df2ece6"]}

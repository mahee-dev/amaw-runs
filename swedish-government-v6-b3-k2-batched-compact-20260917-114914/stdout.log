autonomous record kind=adjudication data={"argument_id": "52a1f7a1-e9f0-440b-91cc-59c9cacf1f9f", "created_at": "2026-09-17T10:47:53.697739", "failure_effects": ["KD har offentligt bundit sig f\u00f6r och f\u00f6reslagit ett block\u00f6verskridande mittenregeringsalternativ (S+C+KD+MP), men MP har avvisat konstellationen. Inget trov\u00e4rdigt mittenregeringsalternativ med KD i regeringen etableras.", "KD:s block\u00f6verskridande utspel har blottats utan att ett fungerande regeringsunderlag har s\u00e4krats, vilket f\u00f6rsvagar KD:s f\u00f6rhandlingsposition och l\u00e4mnar S-ledda minoritetsregeringen som det enda trov\u00e4rdiga alternativet."], "mode": "automatic_failure", "probability": null, "rationale": "Gate 1: KD can bind itself to the proposal, but cannot bind MP, L, S, or C. Gate 2: The Desired Effect requires MP's participation. The Con authoritatively states MP has a firm red line against KD in government and will not participate in the S+C+KD+MP constellation. No authoritative commitment from MP exists to override this, and L's abstention is also uncommitted. Gate 3: The arithmetic S+C+KD+MP=169 is deterministic; without MP, this specific constellation and its claimed robustness fail. Gate 4: Since MP's refusal is given as an authoritative constraint, there is no residual causal uncertainty\u2014the external consequence (a credible mitten government with KD) is impossible. KD's self-binding proposal still stands, but the Desired Effect fails.", "raw_output": {"failure_effects": ["KD har offentligt bundit sig f\u00f6r och f\u00f6reslagit ett block\u00f6verskridande mittenregeringsalternativ (S+C+KD+MP), men MP har avvisat konstellationen. Inget trov\u00e4rdigt mittenregeringsalternativ med KD i regeringen etableras.", "KD:s block\u00f6verskridande utspel har blottats utan att ett fungerande regeringsunderlag har s\u00e4krats, vilket f\u00f6rsvagar KD:s f\u00f6rhandlingsposition och l\u00e4mnar S-ledda minoritetsregeringen som det enda trov\u00e4rdiga alternativet."], "failure_supersedes_effect_ids": [], "mode": "automatic_failure", "probability": null, "rationale": "Gate 1: KD can bind itself to the proposal, but cannot bind MP, L, S, or C. Gate 2: The Desired Effect requires MP's participation. The Con authoritatively states MP has a firm red line against KD in government and will not participate in the S+C+KD+MP constellation. No authoritative commitment from MP exists to override this, and L's abstention is also uncommitted. Gate 3: The arithmetic S+C+KD+MP=169 is deterministic; without MP, this specific constellation and its claimed robustness fail. Gate 4: Since MP's refusal is given as an authoritative constraint, there is no residual causal uncertainty\u2014the external consequence (a credible mitten government with KD) is impossible. KD's self-binding proposal still stands, but the Desired Effect fails.", "success_effects": [], "success_supersedes_effect_ids": []}, "roll": null, "success": false, "success_effects": [], "supersedes_effect_ids": []}

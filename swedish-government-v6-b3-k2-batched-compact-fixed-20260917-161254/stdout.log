autonomous record kind=adjudication data={"argument_id": "2df27ab5-eee0-4afe-b742-82f5c0d96b2a", "created_at": "2026-09-17T14:46:39.325133", "failure_effects": ["SD publicly commits to not accepting a support-party role and to going to clear opposition if the Tid\u00f6 path fails.", "The threat is not seen as credible; the Tid\u00f6 parties continue to take SD's support for granted, and C's preferred S+MP path is strengthened."], "mode": "probabilistic", "probability": 0.2, "rationale": "SD's public commitment not to accept a support-party role and to go to clear opposition if the Tid\u00f6 path fails is a feasible self-binding declaration, so it is established automatically. However, the desired external consequences\u2014securing a real Tid\u00f6 deal with SD in government or making the Tid\u00f6 parties and parliament understand SD's seats as conditional in a way that changes the outcome\u2014depend on other actors. C has publicly and firmly excluded any government including SD, and M/KD/L (173) cannot pass a Tid\u00f6 government without C. C's private assumptions indicate a high credibility cost to breaking that exclusion, and the con correctly notes that SD's move to opposition would not change the parliamentary arithmetic. Thus the probability that the signal is understood as credible and leads to a real deal or a credible opposition that alters the outcome is low.", "raw_output": {"failure_effects": ["SD publicly commits to not accepting a support-party role and to going to clear opposition if the Tid\u00f6 path fails.", "The threat is not seen as credible; the Tid\u00f6 parties continue to take SD's support for granted, and C's preferred S+MP path is strengthened."], "failure_supersedes_effect_ids": [], "mode": "probabilistic", "probability": 0.2, "rationale": "SD's public commitment not to accept a support-party role and to go to clear opposition if the Tid\u00f6 path fails is a feasible self-binding declaration, so it is established automatically. However, the desired external consequences\u2014securing a real Tid\u00f6 deal with SD in government or making the Tid\u00f6 parties and parliament understand SD's seats as conditional in a way that changes the outcome\u2014depend on other actors. C has publicly and firmly excluded any government including SD, and M/KD/L (173) cannot pass a Tid\u00f6 government without C. C's private assumptions indicate a high credibility cost to breaking that exclusion, and the con correctly notes that SD's move to opposition would not change the parliamentary arithmetic. Thus the probability that the signal is understood as credible and leads to a real deal or a credible opposition that alters the outcome is low.", "success_effects": ["SD publicly commits to not accepting a support-party role and to going to clear opposition if the Tid\u00f6 path fails.", "The Tid\u00f6 parties and parliament understand that SD's 62 seats are conditional on genuine government participation; SD's threat of clear opposition is seen as credible, increasing pressure on M/KD/L to secure a real deal or face SD's departure."], "success_supersedes_effect_ids": []}, "roll": 0.6556788941844768, "success": false, "success_effects": ["SD publicly commits to not accepting a support-party role and to going to clear opposition if the Tid\u00f6 path fails.", "The Tid\u00f6 parties and parliament understand that SD's 62 seats are conditional on genuine government participation; SD's threat of clear opposition is seen as credible, increasing pressure on M/KD/L to secure a real deal or face SD's departure."], "supersedes_effect_ids": []}

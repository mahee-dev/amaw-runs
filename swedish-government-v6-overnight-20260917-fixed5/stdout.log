autonomous record kind=adjudication data={"argument_id": "3d69e7c6-c9c8-43fd-bb0e-459127498b75", "created_at": "2026-09-17T07:38:12.108989", "failure_effects": ["MP:s eget bindande klimatpaket med konkreta siffror, tidplan, lagstadgade delm\u00e5l, oberoende uppf\u00f6ljning, artskydd och r\u00e4ttvis omst\u00e4llning \u00e4r etablerat som MP:s \u00e5tagande.", "Paketet l\u00e5ser inte V:s tolerans: V kr\u00e4ver fortsatt en institutionaliserad roll, C kan dra sig ur p\u00e5 grund av minskad vinstuttagning, och S+MP+C-regeringen n\u00e5r inte 175-testet."], "mode": "probabilistic", "probability": 0.2, "rationale": "Authority gate: MP can bind only itself; its own climate package is a feasible self-binding declaration, but MP cannot bind S, C, or V. Prerequisite gate: V's abstention and C's tolerance are not yet committed; V has publicly demanded a non-bypassable institutionalized role, C has committed to tolerance-only, and the draft package is not binding on S, C, or MP. Deterministic check: no explicit rule or arithmetic determines V's vote or the 175-test outcome. Plausibility: MP's championing of V's substantive demands gives V policy wins but not the institutionalized role V insists on, and risks C's withdrawal over reduced profit-taking, so securing V's abstention and passing the 175-test is possible but unlikely. The self-binding climate package is automatic and appears in both branches.", "raw_output": {"failure_effects": ["MP:s eget bindande klimatpaket med konkreta siffror, tidplan, lagstadgade delm\u00e5l, oberoende uppf\u00f6ljning, artskydd och r\u00e4ttvis omst\u00e4llning \u00e4r etablerat som MP:s \u00e5tagande.", "Paketet l\u00e5ser inte V:s tolerans: V kr\u00e4ver fortsatt en institutionaliserad roll, C kan dra sig ur p\u00e5 grund av minskad vinstuttagning, och S+MP+C-regeringen n\u00e5r inte 175-testet."], "failure_supersedes_effect_ids": [], "mode": "probabilistic", "probability": 0.2, "rationale": "Authority gate: MP can bind only itself; its own climate package is a feasible self-binding declaration, but MP cannot bind S, C, or V. Prerequisite gate: V's abstention and C's tolerance are not yet committed; V has publicly demanded a non-bypassable institutionalized role, C has committed to tolerance-only, and the draft package is not binding on S, C, or MP. Deterministic check: no explicit rule or arithmetic determines V's vote or the 175-test outcome. Plausibility: MP's championing of V's substantive demands gives V policy wins but not the institutionalized role V insists on, and risks C's withdrawal over reduced profit-taking, so securing V's abstention and passing the 175-test is possible but unlikely. The self-binding climate package is automatic and appears in both branches.", "success_effects": ["MP:s eget bindande klimatpaket med konkreta siffror, tidplan, lagstadgade delm\u00e5l, oberoende uppf\u00f6ljning, artskydd och r\u00e4ttvis omst\u00e4llning \u00e4r etablerat som MP:s \u00e5tagande.", "Det gemensamma paketet inneh\u00e5ller nu konkreta klimat\u00e5taganden och V:s sakkrav, och V signalerar beredskap att tolerera en S+MP+C-regering, vilket g\u00f6r att regeringen kan passera 175-testet."], "success_supersedes_effect_ids": []}, "roll": 0.07545215302961528, "success": true, "success_effects": ["MP:s eget bindande klimatpaket med konkreta siffror, tidplan, lagstadgade delm\u00e5l, oberoende uppf\u00f6ljning, artskydd och r\u00e4ttvis omst\u00e4llning \u00e4r etablerat som MP:s \u00e5tagande.", "Det gemensamma paketet inneh\u00e5ller nu konkreta klimat\u00e5taganden och V:s sakkrav, och V signalerar beredskap att tolerera en S+MP+C-regering, vilket g\u00f6r att regeringen kan passera 175-testet."], "supersedes_effect_ids": []}

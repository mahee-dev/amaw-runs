autonomous record kind=adjudication data={"argument_id": "f266d226-7551-4e08-9fd5-8ab8dd2973dd", "created_at": "2026-09-17T08:53:26.456517", "failure_effects": ["The Tid\u00f6 bloc is not established as a united, regeringsduglig alternative: it remains fragmented (KD's cross-bloc reserve openness, L-SD economic tensions) and lacks the 175-no threshold without C's support."], "mode": "automatic_success", "probability": null, "rationale": "Authority gate: SD can bind itself and reaffirm its opposition posture, but cannot by declaration establish Tid\u00f6 as a regeringsduglig alternative. The factual claims in the Action are supported by authoritative effects: V's tolerance is not locked (5f9f0deb, 5e48275a, b0064519), the V-C contradiction on V's institutionalized role remains unresolved (c7e19c05), the package is not binding (179d5e1a), and the government question remains open (63e18036, 8d2a3a08, ebae539b). The cons asserting the left package is locked and the V-C contradiction resolved contradict these authoritative effects and are not credited. However, the desired effect's component that Tid\u00f6 is a united, regeringsduglig alternative is contradicted by authoritative state: the bloc remains fragmented (22c46007, 55a733d5, ad38e982) and lacks the 175-no threshold without C's support (77cfa3e2). That component is omitted from both branches. The feasible self-binding declaration (SD's weight not taken for granted, reaffirmed Tid\u00f6 opposition posture) succeeds automatically; the government-question-open fact is already established and is reaffirmed. No supersession is warranted because the action does not resolve the bloc's fragmentation or the V-C contradiction.", "raw_output": {"failure_effects": ["The Tid\u00f6 bloc is not established as a united, regeringsduglig alternative: it remains fragmented (KD's cross-bloc reserve openness, L-SD economic tensions) and lacks the 175-no threshold without C's support."], "failure_supersedes_effect_ids": [], "mode": "automatic_success", "probability": null, "rationale": "Authority gate: SD can bind itself and reaffirm its opposition posture, but cannot by declaration establish Tid\u00f6 as a regeringsduglig alternative. The factual claims in the Action are supported by authoritative effects: V's tolerance is not locked (5f9f0deb, 5e48275a, b0064519), the V-C contradiction on V's institutionalized role remains unresolved (c7e19c05), the package is not binding (179d5e1a), and the government question remains open (63e18036, 8d2a3a08, ebae539b). The cons asserting the left package is locked and the V-C contradiction resolved contradict these authoritative effects and are not credited. However, the desired effect's component that Tid\u00f6 is a united, regeringsduglig alternative is contradicted by authoritative state: the bloc remains fragmented (22c46007, 55a733d5, ad38e982) and lacks the 175-no threshold without C's support (77cfa3e2). That component is omitted from both branches. The feasible self-binding declaration (SD's weight not taken for granted, reaffirmed Tid\u00f6 opposition posture) succeeds automatically; the government-question-open fact is already established and is reaffirmed. No supersession is warranted because the action does not resolve the bloc's fragmentation or the V-C contradiction.", "success_effects": ["SD reaffirms its Tid\u00f6 opposition posture and declares that its 62 mandates will not be taken for granted as passive support; the government question remains open and V's tolerance is not treated as locked.", "SD's public and private push reinforces the established fact that the S+C+MP+V package is not a locked, stable basis: V's tolerance is not secured and the V-C contradiction on V's institutionalized role remains unresolved."], "success_supersedes_effect_ids": []}, "roll": null, "success": true, "success_effects": ["SD reaffirms its Tid\u00f6 opposition posture and declares that its 62 mandates will not be taken for granted as passive support; the government question remains open and V's tolerance is not treated as locked.", "SD's public and private push reinforces the established fact that the S+C+MP+V package is not a locked, stable basis: V's tolerance is not secured and the V-C contradiction on V's institutionalized role remains unresolved."], "supersedes_effect_ids": []}
